<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Studentkab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/action_add</item>
        <item name="android:alertDialogTheme">@style/Theme.Studentkab.Dialog</item>
    </style>

    <!-- Тема диалогов -->
    <style name="Theme.Studentkab.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/action_add</item>
        <item name="android:windowBackground">@drawable/surface_dialog_bg</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Стиль поля ввода в диалогах -->
    <style name="Widget.Studentkab.TextInput" parent="android:Widget.Material.EditText">
        <!-- ИСПРАВЛЕНО ЗДЕСЬ: bg_text_input заменен на field_input_bg -->
        <item name="android:background">@drawable/field_input_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- Закруглённые кнопки действий -->
    <style name="Widget.Studentkab.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Studentkab.Button.Edit" parent="Widget.Studentkab.Button">
        <item name="android:background">@drawable/btn_edit_bg</item>
    </style>

    <style name="Widget.Studentkab.Button.Delete" parent="Widget.Studentkab.Button">
        <item name="android:background">@drawable/btn_delete_bg</item>
    </style>

    <style name="Widget.Studentkab.Button.Add" parent="Widget.Studentkab.Button">
        <item name="android:background">@drawable/btn_add_bg</item>
    </style>

    <!-- Компактная кнопка (Изменить/Удалить в карточке оценки) -->
    <style name="Widget.Studentkab.Button.Compact" parent="Widget.Studentkab.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Studentkab.Button.Compact.Edit" parent="Widget.Studentkab.Button.Compact">
        <item name="android:background">@drawable/btn_edit_container_bg</item>
        <item name="android:textColor">@color/action_edit</item>
    </style>

    <style name="Widget.Studentkab.Button.Compact.Delete" parent="Widget.Studentkab.Button.Compact">
        <item name="android:background">@drawable/btn_delete_container_bg</item>
        <item name="android:textColor">@color/action_delete</item>
    </style>

</resources>