<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Оценка -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оценка (2–5)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/inputGradeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например, 5"
            android:textColorHint="@color/hint_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="number"
            android:maxLength="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="14dp" />

        <!-- Дата -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дата (ГГГГ-ММ-ДД)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/inputGradeDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например, 2026-11-15"
            android:textColorHint="@color/hint_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="date"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="14dp" />

        <!-- Тип работы (обновлённый Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип работы"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/inputWorkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner_field"
            android:paddingStart="14dp"
            android:paddingEnd="40dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:popupBackground="@drawable/bg_spinner_popup"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="14dp" />

        <!-- Комментарий -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Комментарий (необязательно)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/inputGradeComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например, «Работа сдана досрочно»"
            android:textColorHint="@color/hint_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:gravity="top|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_input_field" />
    </LinearLayout>
</ScrollView>